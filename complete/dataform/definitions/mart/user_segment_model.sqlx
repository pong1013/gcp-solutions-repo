config {
  type: "operations",
  schema: "mart",
  name: "user_segment_model",
  tags: ["daily", "ml"],
  hasOutput: true
}

CREATE OR REPLACE MODEL ${self()}
OPTIONS (
  model_type = 'kmeans',
  num_clusters = 4,
  standardize_features = TRUE,
  max_iterations = 20
) AS
SELECT
  CAST(deal_count AS FLOAT64) AS deal_count,
  CAST(won_deal_count AS FLOAT64) AS won_deal_count,
  CAST(won_revenue AS FLOAT64) AS won_revenue,
  CAST(ticket_count AS FLOAT64) AS ticket_count,
  CAST(open_ticket_count AS FLOAT64) AS open_ticket_count,
  CAST(avg_csat_score AS FLOAT64) AS avg_csat_score,
  CAST(campaign_event_count AS FLOAT64) AS campaign_event_count,
  CAST(high_intent_event_count AS FLOAT64) AS high_intent_event_count,
  CAST(account_age_days AS FLOAT64) AS account_age_days,
  CAST(days_since_last_login AS FLOAT64) AS days_since_last_login
FROM ${ref("user_segmentation_features")}
WHERE user_id IS NOT NULL;
