config {
  type: "table",
  schema: "mart",
  name: "user_segmentation_features",
  tags: ["daily", "mart"]
}

SELECT
  user_id,
  email,
  country,
  income_band,
  consent_email,
  deal_count,
  won_deal_count,
  won_revenue,
  ticket_count,
  open_ticket_count,
  avg_csat_score,
  campaign_event_count,
  high_intent_event_count,
  DATE_DIFF(CURRENT_DATE(), signup_date, DAY) AS account_age_days,
  DATE_DIFF(CURRENT_DATE(), DATE(last_login_at), DAY) AS days_since_last_login,
  CURRENT_TIMESTAMP() AS feature_generated_at
FROM ${ref("user_360")}
